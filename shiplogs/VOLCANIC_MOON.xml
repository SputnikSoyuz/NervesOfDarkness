			<Text>$NoD_WARPCORE_R</Text>
		</RumorFact>

		<ExploreFact>
			<ID>NoD_WARPCORE_E</ID>
			<Text>$NoD_WARPCORE_E</Text>
		</ExploreFact>
	</Entry>
</AstroObjectEntry>