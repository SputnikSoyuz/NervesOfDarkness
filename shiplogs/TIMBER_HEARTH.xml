<!-- Example File -->
<!-- All files must have "AstroObjectEntry" as their root element, the xmlns:xsi=... and xsi:noNamespaceSchemaLocation=... is optional but heavily encouraged to reduce errors -->
<AstroObjectEntry xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"  xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Outer-Wilds-New-Horizons/new-horizons/main/NewHorizons/Schemas/shiplog_schema.xsd">
    <ID>TIMBER_HEARTH</ID> <!-- The ID of the planet this xml file is for -->

    <Entry> <!-- An Entry For This Planet -->
        <ID>NoD_HORNFELS</ID> <!-- The ID of this entry -->
		<Name>$NoD_HORNFELS</Name> <!-- The name to show for this entry both on the card and in map mode -->

        <RumorFact> <!-- A rumor fact that belongs to this entry -->
            <ID>NoD_HORNFELS_R</ID> <!-- The ID of this fact -->
            <Text>$NoD_HORNFELS_R</Text> <!-- The Text to display for this fact -->
        </RumorFact>

        <ExploreFact> <!-- An explore fact that belongs to this entry -->
            <ID>NoD_HORNFELS_E1</ID> <!-- The ID of this fact -->
            <Text>$NoD_HORNFELS_E1</Text> <!-- The Text to display for this fact, notice how you can use color just like in dialogue -->
        </ExploreFact>

        <ExploreFact> <!-- An explore fact that belongs to this entry -->
            <ID>NoD_HORNFELS_E2</ID> <!-- The ID of this fact -->
            <Text>$NoD_HORNFELS_E2</Text> <!-- The Text to display for this fact, notice how you can use color just like in dialogue -->
        </ExploreFact>

		<ExploreFact>
			<ID>NoD_HORNFELS_E3</ID>
			<Text>$NoD_HORNFELS_E3</Text>
		</ExploreFact>

		<ExploreFact>
			<ID>NoD_HORNFELS_E4</ID>
			<Text>$NoD_HORNFELS_E4</Text>
		</ExploreFact>
    </Entry>
</AstroObjectEntry>